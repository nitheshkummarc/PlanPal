# Backend API origin used by the axios client.
VITE_API_BASE_URL=http://localhost:5000

# OFFLINE UI PREVIEW ONLY — opt-in mock mode.
# Set to 'true' to intercept all axios calls with a mock adapter and bypass
# real authentication with a hardcoded preview user. ANY other value
# (including leaving this unset) uses the real backend.
# This MUST remain unset in production builds.
# VITE_BYPASS_AUTH=true
